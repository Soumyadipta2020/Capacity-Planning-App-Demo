# Use 'databricks' for Databricks cluster/SQL compute status and Unity Catalog storage.
# Use 'csv' or 'local' to run completely offline using local Pandas CSVs.
STORAGE_MODE=databricks

# Databricks Connect and Databricks SDK settings.
# DATABRICKS_HOST should include https://, for example https://adb-xxx.azuredatabricks.net.
DATABRICKS_HOST=
DATABRICKS_CLUSTER_ID=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TOKEN=
DATABRICKS_WORKSPACE_ID=

# Unity Catalog details
DATABRICKS_CATALOG=capacity_planning
DATABRICKS_SCHEMA=dev

# Optional simulation state for testing cluster lifecycle without cloud credentials:
# Set to 'TERMINATED', 'STARTING', or 'RUNNING'
# SIMULATE_CLUSTER_STATE=TERMINATED
